    private let sentinelFilename = ".debug-scenario"
    private let outputSubdir = "leak-repro"

    private let outputDir: URL = {
        let docs = URL(fileURLWithPath: NSHomeDirectory(), isDirectory: true)
            .appendingPathComponent("Documents", isDirectory: true)
        return docs.appendingPathComponent("leak-repro", isDirectory: true)
    }()

    private var sceneConnectedContinuation: ((UIScene) -> Void)?
