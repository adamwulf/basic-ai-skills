    // MARK: - Entry points

    /// Activate via env var or, on Catalyst where LaunchServices strips
    /// env vars, via a sentinel file in the sandbox Documents dir.
    func startIfRequested() {
        let env = ProcessInfo.processInfo.environment
        var shouldStart = env[envVar] == scenarioName
        if !shouldStart {
            let docs = URL(fileURLWithPath: NSHomeDirectory(), isDirectory: true)
                .appendingPathComponent("Documents", isDirectory: true)
            let sentinel = docs.appendingPathComponent(sentinelFilename)
            if let contents = try? String(contentsOf: sentinel, encoding: .utf8) {
                if contents.trimmingCharacters(in: .whitespacesAndNewlines) == scenarioName {
                    shouldStart = true
                }
            }
        }
        guard shouldStart, !started else { return }
        started = true
        startTime = Date()

        do {
            try FileManager.default.createDirectory(at: outputDir, withIntermediateDirectories: true)
        } catch {
            NSLog("LeakRepro: cannot create output dir at \(outputDir.path): \(error)")
            return
        }

        // PID for the external snapshotter; avoids lsappinfo ambiguity.
        let pidPath = outputDir.appendingPathComponent("getpid.txt")
        try? "\(getpid())\n".write(to: pidPath, atomically: true, encoding: .utf8)

        appendLog("LeakRepro starting (scenario=\(scenarioName), pid=\(getpid()))")

        Task.detached { [weak self] in
            await self?.runScenario()
        }
    }

    func sceneDidConnect(_ scene: UIScene) {
        guard started else { return }
        if w1Scene == nil {
            w1Scene = scene
            appendLog("noted W1 scene: \(scene.session.persistentIdentifier)")
            return
        }
        if w2Scene == nil {
            w2Scene = scene
            appendLog("noted W2 scene: \(scene.session.persistentIdentifier)")
            sceneConnectedContinuation?(scene)
            sceneConnectedContinuation = nil
        }
    }

    // MARK: - Scenario

    // REPLACE: this is the typical "open two, close the first" shape.
    // Adapt the phases to match the user-visible flow you're hunting.
    private func runScenario() async {
        appendLog("phase 0: waiting for startup readiness")
        let ready = await waitForStartupReadiness(timeoutSeconds: 180)
        if !ready {
            writeSentinel(name: "done", contents: "ABORT: startup not ready within timeout\n")
            return
        }

        guard let (thing1, thing2) = await pickThings() else {
            writeSentinel(name: "done", contents: "ABORT: could not find two things\n")
            return
        }

        await switchActiveSceneToThing(thing1)
        appendLog("phase 1: driving content load for ~30s")
        await driveContentLoad(durationSeconds: 30)

        appendLog("phase 2: wait 60s for steady state")
        try? await Task.sleep(nanoseconds: 60 * NSEC_PER_SEC)

        await captureCheckpoint(label: "A", note: "thing1-loaded")

        appendLog("phase 3: opening thing2 in new window")
        await openThingInNewWindow(thing2)
        await waitForSecondSceneConnection(timeoutSeconds: 30)

        appendLog("phase 4: wait 30s for two-window steady state")
        try? await Task.sleep(nanoseconds: 30 * NSEC_PER_SEC)

        await captureCheckpoint(label: "B", note: "thing1+thing2-open")

        appendLog("phase 5: destroying thing1 scene")
        let destroyed = await destroyW1Scene()
        if !destroyed {
            writeSentinel(name: "done", contents: "ABORT: thing1 destruction failed\n")
            return
        }

        await spinMainLoopAndDrain(iterations: 30)
        appendLog("phase 6: wait 120s for post-close release window")
        try? await Task.sleep(nanoseconds: 120 * NSEC_PER_SEC)

        await captureCheckpoint(label: "C", note: "thing1-closed-120s")

        writeSentinel(name: "done", contents: "OK\n")
    }

