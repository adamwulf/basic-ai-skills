    // MARK: - Scene management

    /// Wait up to `timeoutSeconds` for the app's readiness check to return true.
    private func waitForStartupReadiness(timeoutSeconds: Int) async -> Bool {
        let start = Date()
        while Date().timeIntervalSince(start) < TimeInterval(timeoutSeconds) {
            let ready = await MainActor.run { self.appStartupReadinessCheck() }
            if ready {
                appendLog("startup ready after \(Int(Date().timeIntervalSince(start)))s")
                return true
            }
            try? await Task.sleep(nanoseconds: 2 * NSEC_PER_SEC)
        }
        appendLog("startup readiness gave up after \(timeoutSeconds)s")
        return false
    }

    private func waitForSecondSceneConnection(timeoutSeconds: Int) async {
        let start = Date()
        while Date().timeIntervalSince(start) < TimeInterval(timeoutSeconds) {
            if await MainActor.run(body: { w2Scene != nil }) {
                appendLog("W2 scene connected after \(Int(Date().timeIntervalSince(start)))s")
                return
            }
            try? await Task.sleep(nanoseconds: 500 * NSEC_PER_MSEC)
        }
        appendLog("WARN: W2 scene never connected within \(timeoutSeconds)s")
    }

    @MainActor
    private func destroyW1Scene() async -> Bool {
        guard w2Scene != nil else {
            appendLog("ABORT: w2Scene is nil; refusing to destroy what may be the only window")
            return false
        }
        let target: UIScene?
        if let cached = w1Scene, cached != w2Scene {
            target = cached
        } else {
            target = UIApplication.shared.connectedScenes.first { $0 != w2Scene }
        }
        guard let scene = target else {
            appendLog("ERROR: could not find W1 scene to destroy")
            return false
        }
        appendLog("destroying W1 scene \(scene.session.persistentIdentifier)")
        UIApplication.shared.requestSceneSessionDestruction(
            scene.session, options: nil,
            errorHandler: { error in
                LeakRepro.shared.appendLog("scene destruction error: \(error)")
            }
        )
        return true
    }

    private func spinMainLoopAndDrain(iterations: Int) async {
        await MainActor.run {
            for _ in 0..<iterations {
                autoreleasepool {
                    RunLoop.main.run(until: Date().addingTimeInterval(0.1))
                }
            }
        }
    }

    // MARK: - Snapshots

    private struct VMInfo {
        let rssBytes: UInt64
        let physFootprintBytes: UInt64
    }

    /// REV1 count check: trust phys_footprint only when kernel returned the rev1 struct.
    private func captureVMInfo() -> VMInfo? {
        let TASK_VM_INFO_COUNT = mach_msg_type_number_t(
            MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<integer_t>.size)
        guard let offset = MemoryLayout.offset(of: \task_vm_info_data_t.min_address) else {
            return nil
        }
        let TASK_VM_INFO_REV1_COUNT = mach_msg_type_number_t(offset / MemoryLayout<integer_t>.size)
        var info = task_vm_info_data_t()
        var count = TASK_VM_INFO_COUNT
        let kr = withUnsafeMutablePointer(to: &info) {
            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) { ptr in
                task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), ptr, &count)
            }
        }
        guard kr == KERN_SUCCESS, count >= TASK_VM_INFO_REV1_COUNT else {
            return nil
        }
        return VMInfo(rssBytes: UInt64(info.resident_size),
                      physFootprintBytes: UInt64(info.phys_footprint))
    }

    private func captureCheckpoint(label: String, note: String) async {
        let vmInfo = captureVMInfo()
        let timestamp = ISO8601DateFormatter().string(from: Date())
        let rss = vmInfo?.rssBytes ?? 0
        let phys = vmInfo?.physFootprintBytes ?? 0
        appendLog("CHECKPOINT \(label) (\(note)): rss=\(rss / 1024 / 1024) MiB, phys=\(phys / 1024 / 1024) MiB")
        appendCSV(timestamp: timestamp, checkpoint: label, rss: rss, phys: phys)

        writeSentinel(name: "checkpoint-\(label).request",
                      contents: "label=\(label)\npid=\(getpid())\nnote=\(note)\nrequested_at=\(timestamp)\n")

        let doneFile = outputDir.appendingPathComponent("checkpoint-\(label).done")
        let timeoutSec = 600
        let startTime = Date()
        while Date().timeIntervalSince(startTime) < TimeInterval(timeoutSec) {
            if FileManager.default.fileExists(atPath: doneFile.path) {
                appendLog("checkpoint \(label) snapshot completed after \(Int(Date().timeIntervalSince(startTime)))s")
                return
            }
            try? await Task.sleep(nanoseconds: 1 * NSEC_PER_SEC)
        }
        appendLog("WARN: checkpoint \(label) snapshot timed out after \(timeoutSec)s")
    }

    // MARK: - Output helpers

    private func appendLog(_ msg: String) {
        let ts = ISO8601DateFormatter().string(from: Date())
        let line = "[\(ts)] \(msg)\n"
        if let data = line.data(using: .utf8) {
            let url = outputDir.appendingPathComponent("scenario.log")
            if let handle = try? FileHandle(forWritingTo: url) {
                _ = try? handle.seekToEnd()
                try? handle.write(contentsOf: data)
                try? handle.close()
            } else {
                try? data.write(to: url)
            }
        }
        NSLog("LeakRepro: \(msg)")
    }

    private func appendCSV(timestamp: String, checkpoint: String, rss: UInt64, phys: UInt64) {
        let url = outputDir.appendingPathComponent("timeline.csv")
        let isNew = !FileManager.default.fileExists(atPath: url.path)
        var line = ""
        if isNew { line += "timestamp,checkpoint,rss_bytes,phys_footprint_bytes\n" }
        line += "\(timestamp),\(checkpoint),\(rss),\(phys)\n"
        if let data = line.data(using: .utf8) {
            if let handle = try? FileHandle(forWritingTo: url) {
                _ = try? handle.seekToEnd()
                try? handle.write(contentsOf: data)
                try? handle.close()
            } else {
                try? data.write(to: url)
            }
        }
    }

    private func writeSentinel(name: String, contents: String) {
        let url = outputDir.appendingPathComponent(name)
        try? contents.write(to: url, atomically: true, encoding: .utf8)
    }
